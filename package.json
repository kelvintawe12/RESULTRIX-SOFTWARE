{
  "name": "edumaster",
  "version": "1.0.0",
  "description": "EduMaster is a modern, multi-tenant SaaS platform for comprehensive school management. Built with React, TypeScript, and Supabase, it streamlines academic, financial, and administrative operations for educational institutions.",
  "main": "index.js",
  "type": "module",
  "private": true,
  "author": "EduMaster Team <support@edumaster.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvintawe12/RESULTRIX-SOFTWARE.git"
  },
  "bugs": {
    "url": "https://github.com/kelvintawe12/RESULTRIX-SOFTWARE/issues"
  },
  "homepage": "https://edumaster.com",
  "keywords": [
    "school-management",
    "education",
    "saas",
    "react",
    "typescript",
    "supabase",
    "academic-management",
    "financial-management",
    "multi-tenant",
    "pwa",
    "dashboard",
    "student",
    "teacher",
    "bursar",
    "admin",
    "analytics",
    "reporting",
    "attendance",
    "fee-management",
    "audit-logs"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "deploy": "npm run build && npm run preview",
    "start": "vite preview",
    "pwa:build": "vite build && vite-plugin-pwa generateSW"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.0",
    "framer-motion": "^11.5.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "^8.4.32",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}
